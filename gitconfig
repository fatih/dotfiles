[user]
	name = Fatih Arslan
	email = ftharsln@gmail.com

# Machine-local / private overrides (identity routing, etc.). Not tracked
# here; git silently ignores this if the file is absent.
[include]
	path = ~/.config/git/local

[alias]
	st = status -sb
	ci = commit
	all = commit -am
	br = branch
	co = checkout
	di = diff
	dic = diff --cached
	lg = log -p
	lol = log --graph --decorate --pretty=oneline --abbrev-commit
	lola = log --graph --decorate --pretty=oneline --abbrev-commit --all
	ls = ls-files
	# Show files ignored by git:
	ign = ls-files -o -i --exclude-standard

	shoot = push origin --delete
	unstage = reset HEAD --
	prev = checkout -
	discard = checkout -- 

[color]
	ui = auto
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "status"]
	added = yellow
	changed = green
	untracked = cyan
[core]
	whitespace=fix,-indent-with-non-tab,trailing-space,cr-at-eol
	editor = nvim
	quotepath = false
	excludesfile = ~/.gitignore
[credential]
	helper = osxkeychain
[github]
	user = fatih
[mergetool]
	keepBackup = true
[filter "media"]
	clean = git-media-clean %f
	smudge = git-media-smudge %f
[push]
	default = current
# No URL rewrite here on purpose: insteadOf rules are additive, so a machine
# that authenticates over HTTPS can't override an ssh rule set here. Each
# machine picks its transport in ~/.config/git/local instead.
[pull]
	rebase = false
[init]
	defaultBranch = main
